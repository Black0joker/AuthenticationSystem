{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=IdentityAuthDb;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "IdentityAuthServer",
    "Audience": "IdentityAuthClient",
    "AccessTokenExpirationMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "EnableSensitiveDataLogging": false,
  "Database": {
    "AutoMigrate": true,
    "AutoSeed": true
  },
  "RateLimiting": {
    "Enabled": true
  }
}
